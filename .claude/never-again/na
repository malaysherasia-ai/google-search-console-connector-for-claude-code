#!/bin/sh
""":"
# Re-exec under a Python that actually runs. `env python3` finds the Microsoft
# Store stub on Windows, which exits without running anything.
for c in ${NA_PYTHON:-} python3 python py; do
  # Existence is not the test — run a statement and require exit 0.
  if "$c" -c 'import sys' >/dev/null 2>&1; then
    exec "$c" "$0" "$@"
  fi
done
echo "never-again: no working python found" >&2
exit 1
":"""
VERSION = "1.10.0"
USAGE = """na — never-again local CLI.

Everything here is counted, not reasoned. It costs no tokens by design.

  na              stats, including loaded rule density for the current directory
  na report       the same numbers as a Markdown page, counted from the logs:
                  every lesson, every fire, and which agents ever called the
                  hook. Hand this over instead of a summary written by a model
  na sweep   L017 run one hook's check over every file in the tree, not just a
                  commit's files, and print the hits; nothing is recorded
  na sort         reorder rule lines by fire count (most-hit first) in each LESSONS.md
  na review       every proposal the record supports, on one page: stale lessons,
                  rules that say the same thing, hooks ready to promote, warned-past
                  fires nobody graded, noisy hooks. Changes nothing
  na stale        lessons with no trace in the last 50 commits: no fire, no grade,
                  no mention, no archive change (--commits N for another window)
  na failures     what failed under the agent since the last commit and passed
                  after the tree changed: the fixes the commit will ask about,
                  with the error each one showed (Claude Code reports them)
  na dup "text"   existing rules that say much the same as this one; run it before
                  filing a rule line (na dup L017 compares a filed rule)
  na uninstall    remove never-again from this repo (--yes to skip the prompt)
  na upgrade      fetch the newest release and re-run its installer here;
                  a newer release is noticed once a day after a commit and
                  named on the next one ("updates": "off" in state.json stops that;
                  "block" stops the commit itself until the repo moves)
                  (--check only looks; --yes skips the prompt; --later lets
                  commits through until tomorrow or the next release; --from
                  DIR|TARBALL installs from a local copy instead of GitHub)
  na ok      L017 the latest fire was right      (grades that fire; counts toward promotion)
  na wrong   L017 the latest fire was a false positive (grades it; streak resets)
  na promote L017 warn -> block
  na demote  L017 block -> warn
  na retire  L017 remove the rule line and deregister the hook; keep the archive
  na why     L017 print the full story
  na none [why]   the next commit is a fix with nothing to learn: the capture
                  check stays quiet for it ("capture": "off" in state.json
                  turns the check off for good; "block" makes it refuse)
  na import       list the notes files already in this repo that the skill can
                  turn into lessons, and what has been imported so far
  na import --mark PATH [--filed N]   record that PATH was imported
  na index        every live hook with its mode, trigger and watched extensions,
                  which is what the dispatcher runs from

Fires are recorded by the hooks themselves. What happened next is recorded too:
"declined" when the person stopped at the warning, "proceeded" when they went
ahead anyway, "blocked" in block mode. A declined fire counts as correct on its
own; use `na ok` / `na wrong` to say otherwise, or to grade a proceeded one.
"""
import json
import os
import re
import sys
import time
from collections import Counter

# Windows consoles default to cp1252, which cannot encode the box-drawing and
# em-dash characters used below, and files default to the same codec.
if hasattr(sys.stdout, "reconfigure"):
    # newline="\n": shell callers split our output on "\n", and a text-mode
    # stdout on Windows would otherwise glue a "\r" to every last field.
    sys.stdout.reconfigure(encoding="utf-8", errors="replace", newline="\n")
if hasattr(sys.stderr, "reconfigure"):
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")

ROOT = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
while not os.path.isdir(os.path.join(ROOT, ".claude", "never-again")):
    parent = os.path.dirname(ROOT)
    if parent == ROOT:
        sys.exit("never-again is not installed here. Run install.sh first.")
    ROOT = parent

BASE = os.path.join(ROOT, ".claude", "never-again")
STATE = os.path.join(BASE, "state.json")
FIRES = os.path.join(BASE, "fires.log")
ARCHIVE = os.path.join(BASE, "archive")
VERIFIED = os.path.join(BASE, "verified")
HOOKS = os.path.join(ROOT, ".claude", "hooks", "na")
SETTINGS = os.path.join(ROOT, ".claude", "settings.json")

# A fire that is still "pending" this long after it was written, with no tool
# call having run afterwards, is one the person declined at the prompt.
SETTLE_AFTER_S = 120
PROMOTE_AT = 5


def load():
    with open(STATE, encoding="utf-8") as f:
        return json.load(f)


def save(state):
    with open(STATE, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)
        f.write("\n")


MARKER = "managed by the never-again skill"


def managed(path):
    """The root LESSONS.md is always the tool's: the installer said so, and the
    skill appends there. Any other LESSONS.md in the tree is only ours if it
    carries the template's marker comment. A project's own docs/LESSONS.md in
    some other format must never be counted, sorted or edited."""
    if os.path.dirname(os.path.abspath(path)) == os.path.abspath(ROOT):
        return True
    rel = os.path.relpath(path, ROOT).replace(os.sep, "/")
    if rel in _lesson_named_files():
        return True
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return MARKER in f.read(4096)     # the marker sits in the header
    except OSError:
        return False


_NAMED = None


def _lesson_named_files():
    """Files that lesson records say they were filed into. A package file
    written without the marker is still ours if a lesson points at it."""
    global _NAMED
    if _NAMED is None:
        _NAMED = set()
        try:
            for v in load().get("lessons", {}).values():
                f = v.get("file")
                if isinstance(f, str) and f:
                    _NAMED.add(f.replace("\\", "/"))
        except (OSError, ValueError):
            pass
    return _NAMED


_FILES = None


def lesson_files():
    """Managed LESSONS.md files, walked once per run."""
    global _FILES
    if _FILES is not None:
        return _FILES
    out = []
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames
                       if d not in (".git", "node_modules", ".claude", "dist", "build")]
        if "LESSONS.md" in filenames:
            p = os.path.join(dirpath, "LESSONS.md")
            if managed(p):
                out.append(p)
    _FILES = out
    return out


def loaded_files(cwd=None):
    """The LESSONS.md files Claude actually sees from a working directory:
    the root file plus the nearest one at or above cwd inside the repo."""
    # realpath on both: on macOS /tmp is a symlink to /private/tmp, and the
    # working directory comes back resolved while ROOT does not.
    cwd = os.path.normcase(os.path.realpath(cwd or os.getcwd()))
    root = os.path.normcase(os.path.realpath(ROOT))
    root_file = os.path.join(ROOT, "LESSONS.md")
    out = [root_file] if os.path.exists(root_file) else []
    d = cwd
    while d.startswith(root) and d != root:
        f = os.path.join(d, "LESSONS.md")
        if os.path.exists(f) and f not in out and managed(f):
            out.append(f)
            break
        d = os.path.dirname(d)
    return out


RULE_RE = re.compile(r"^\s*-\s+\[(?P<scope>[^\]]+)\]\s+(?P<text>.+?)\s*\((?P<id>L\d+)\)\s*$")


def rules(paths=None):
    found = []
    for path in (paths if paths is not None else lesson_files()):
        with open(path, encoding="utf-8") as f:
            for line in f:
                m = RULE_RE.match(line)
                if m:
                    found.append((os.path.relpath(path, ROOT), m.group("id"),
                                  m.group("scope"), m.group("text")))
    return found


# ---------------------------------------------------------------------------
# fires.log
#
# One line per fire, tab separated:
#   ts  id  mode  source  outcome  grade  ref
#   source   claude | git
#   outcome  pending | proceeded | declined | blocked
#   grade    - | ok | wrong
#   ref      the Claude Code tool_use_id when the payload carried one, else -
#   tree     a fingerprint of the working tree at the fire, so a second look
#            at the same commit (git after Claude Code) can be told from a
#            new commit after a fix
# Lines from before this format (ts, id, mode) still parse; their outcome is
# unknown and shown as "-".
# ---------------------------------------------------------------------------

COLS = ("ts", "id", "mode", "source", "outcome", "grade", "ref", "tree")


def parse_ts(ts):
    """UTC timestamp to epoch seconds. mktime() minus time.timezone was wrong
    by an hour during daylight saving, which made every fresh fire look stale
    and settled it as declined before the after-commit hook could mark it."""
    import calendar
    try:
        return calendar.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%SZ"))
    except Exception:
        return 0


def now_ts():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def read_log():
    if not os.path.exists(FIRES):
        return []
    rows = []
    with open(FIRES, encoding="utf-8") as f:
        for ln in f:
            ln = ln.rstrip("\n")
            if not ln.strip():
                continue
            parts = ln.split("\t")
            row = dict(zip(COLS, parts + ["-"] * (len(COLS) - len(parts))))
            if len(parts) < 4:
                row["source"] = "claude"
            rows.append(row)
    return rows


def write_log(rows):
    os.makedirs(BASE, exist_ok=True)
    with open(FIRES, "w", encoding="utf-8", newline="\n") as f:
        for r in rows:
            f.write("\t".join(r.get(c, "-") or "-" for c in COLS) + "\n")


def settle(rows, lid=None, age=SETTLE_AFTER_S):
    """Pending fires nobody proceeded past are declined fires. A pending fire
    for the same hook is settled at once: the hook firing again means the
    previous attempt did not go through. Others only once they are stale, so
    two hooks firing on the same call do not settle each other."""
    now = time.time()
    changed = False
    for r in rows:
        if r["outcome"] != "pending":
            continue
        if (lid and r["id"] == lid) or now - parse_ts(r["ts"]) > age:
            r["outcome"] = "declined"
            changed = True
    return changed


def streak(rows, lid):
    """Consecutive correct fires: an explicit ok, or an ungraded declined fire.
    A wrong grade resets it. Proceeded fires count only when graded."""
    n = 0
    for r in rows:
        if r["id"] != lid:
            continue
        if r["grade"] == "wrong":
            n = 0
        elif r["grade"] == "ok" or (r["grade"] == "-" and r["outcome"] == "declined"):
            n += 1
    return n


def tree_fingerprint():
    """What is about to be committed, cheaply: every changed or untracked
    path with its size and mtime. Same tree, same fingerprint; a fix changes
    it. "-" when git cannot answer."""
    import hashlib
    import subprocess
    try:
        p = subprocess.run(["git", "-C", ROOT, "status", "--porcelain=v1", "-uall"],
                           capture_output=True, text=True, encoding="utf-8", errors="replace")
    except OSError:
        return "-"
    if p.returncode != 0:
        return "-"
    # Paths and their bytes, not their staging state: Claude's `git add -A &&
    # git commit` stages between the PreToolUse fire and the git hook, and
    # that is still the same commit.
    h = hashlib.sha256()
    for line in sorted(p.stdout.splitlines()):
        path = line[3:].split(" -> ")[-1]
        full = os.path.join(ROOT, path)
        try:
            st = os.stat(full)
            h.update(("%s\t%d\t%d\n" % (path, st.st_size, st.st_mtime_ns)).encode("utf-8"))
        except OSError:
            h.update((path + "\tgone\n").encode("utf-8"))
    return h.hexdigest()[:16]


def cmd_fired(lid, mode, source, ref):
    rows = read_log()
    settle(rows, lid=lid)
    if mode == "block":
        outcome = "blocked"
    elif source == "git":
        outcome = "proceeded"      # git warn mode cannot stop the commit
    else:
        outcome = "pending"
    rows.append({"ts": now_ts(), "id": lid, "mode": mode, "source": source,
                 "outcome": outcome, "grade": "-", "ref": ref or "-",
                 "tree": tree_fingerprint()})
    write_log(rows)
    return 0


def cmd_proceeded(argv):
    """The tool call ran, so whoever saw the prompt chose to go on."""
    ref = None
    lid = None
    only_if_pending = "--if-pending" in argv
    same_tree = "--same-tree" in argv
    if "--tool-use-id" in argv:
        ref = argv[argv.index("--tool-use-id") + 1]
    if "--id" in argv:
        lid = argv[argv.index("--id") + 1]
    rows = read_log()
    # A fire nobody proceeded past for a while is a decline; settle those
    # first so an old declined fire can never be mistaken for this commit.
    if settle(rows):
        write_log(rows)
    pending = [r for r in rows if r["outcome"] == "pending" and (not lid or r["id"] == lid)]
    if same_tree:
        tree = tree_fingerprint()
        pending = [r for r in pending if r.get("tree") == tree and tree != "-"]
    if ref:
        matched = [r for r in pending if r["ref"] == ref]
        # A payload without ids on the PreToolUse side leaves ref "-"; then
        # the pending set is the best answer available.
        pending = matched or [r for r in pending if r["ref"] == "-"]
    if not pending:
        return 1 if only_if_pending else 0
    for r in pending:
        r["outcome"] = "proceeded"
    write_log(rows)
    # The ids that just went past a warning, one per line, for the
    # after-commit hook to hand back: a proceeded fire counts only once
    # graded, and the agent that saw the reason and the diff can grade it.
    for lid in sorted({r["id"] for r in pending if r["id"] != CAPTURE_ID}):
        print(lid)
    return 0


def fires():
    rows = read_log()
    if settle(rows):
        write_log(rows)
    return rows


def bar(n, total, width=18):
    if not total:
        return ""
    filled = max(1, round(width * n / total)) if n else 0
    return "█" * filled + "·" * (width - filled)


def stats():
    state = load()
    rs = rules()
    fr = fires()
    # The capture check is not a lesson: its fires are counted on their own
    # line, never toward a streak or the prevented total.
    nudges = [r for r in fr if r["id"] == CAPTURE_ID]
    fr = [r for r in fr if r["id"] != CAPTURE_ID]
    lessons = state.get("lessons", {})
    hooks = {k: v for k, v in lessons.items() if v.get("form") == "hook"}
    blocking = [k for k, v in hooks.items() if v.get("mode") == "block"]
    warning = [k for k, v in hooks.items() if v.get("mode") == "warn"]
    cap = state.get("cap", 40)
    warn_at = state.get("loadedWarn", 60)
    per = state.get("tokensPerPreventedRepeat", 8000)
    loaded = rules(loaded_files())

    print()
    print("  never-again")
    print("  " + "-" * 46)
    print(f"  rules           {len(rs)} across {len(lesson_files())} file{'s' if len(lesson_files()) != 1 else ''}  (cap {cap} per file)")
    print(f"  loaded here     {len(loaded)}  " + ("!" if len(loaded) > warn_at else "") + f"(warn above {warn_at})")
    print(f"  hooks           {len(hooks)}  ({len(blocking)} blocking, {len(warning)} warn)")
    rule_only = len(lessons) - len(hooks)
    if rule_only:
        print(f"  rule-only       {rule_only}  (judgement calls, no script)")
    print(f"  hook fires      {len(fr)}")

    blocked = [r for r in fr if r["outcome"] == "blocked"]
    declined = [r for r in fr if r["outcome"] == "declined"]
    proceeded = [r for r in fr if r["outcome"] == "proceeded"]
    prevented = len(blocked) + len(declined)
    print()
    print(f"  prevented       {prevented}  ({len(blocked)} denied, {len(declined)} declined at the prompt)")
    print(f"  warned past     {len(proceeded)}  (asked, and the person went ahead)")
    print(f"  est. tokens     ~{prevented * per:,} saved")
    print(f"                  (at {per:,}/repeat — edit in state.json)")
    capture = state.get("capture", "warn")
    if capture == "off":
        print("  capture         off  (a fix committed with no lesson is not noticed)")
    else:
        stopped = sum(1 for r in nudges if r["outcome"] in ("declined", "blocked"))
        went = sum(1 for r in nudges if r["outcome"] == "proceeded")
        print(f"  capture nudges  {len(nudges)}  (a fix committed with no lesson filed:"
              f" {stopped} stopped, {went} went ahead)")
        fixed = fixed_unfiled()
        if fixed:
            print(f"  fixed, unfiled  {len(fixed)}  (failed under the agent, passed after a change, no commit yet: na failures)")

    if fr:
        print()
        print("  per hook        fires  denied  declined  proceeded  ok  wrong  streak")
        for lid in sorted({r["id"] for r in fr}):
            mine = [r for r in fr if r["id"] == lid]
            c = Counter(r["outcome"] for r in mine)
            g = Counter(r["grade"] for r in mine)
            print(f"    {lid:<10}  {len(mine):>5}  {c['blocked']:>6}  {c['declined']:>8}  {c['proceeded']:>9}"
                  f"  {g['ok']:>2}  {g['wrong']:>5}  {streak(fr, lid):>6}")
        counts = Counter(r["id"] for r in fr)
        print()
        print("  most-hit")
        top = counts.most_common(5)
        mx = top[0][1]
        for lid, n in top:
            label = next((t for _, i, _, t in rs if i == lid), lid)
            label = label[:38] + ("…" if len(label) > 38 else "")
            print(f"    {lid}  {bar(n, mx)}  {n:>3}  {label}")

    ready = [k for k, v in hooks.items()
             if v.get("mode") == "warn" and streak(fr, k) >= PROMOTE_AT]
    if ready:
        print()
        print("  ready to promote: " + ", ".join(sorted(ready)))
        print("    na promote " + sorted(ready)[0])

    todo = notes_todo()
    if todo:
        print()
        print(f"  notes           {len(todo)} file{'s' if len(todo) != 1 else ''} of existing rules or lessons not imported yet"
              f" ({sum(n for _, n in todo)} lines): na import")

    over = [p for p in lesson_files() if len(rules([p])) >= cap]
    if over:
        print()
        for p in over:
            print(f"  ! {os.path.relpath(p, ROOT)} is at cap — retire or promote one before adding another")
    if len(loaded) > warn_at:
        print()
        print(f"  ! {len(loaded)} rules load on every turn from this directory.")
        print(f"    Compliance falls as the list grows. Split by package, retire, or promote.")
    print()


CALLS = os.path.join(BASE, "calls.log")


def read_calls():
    """calls.log: one line per commit the dispatcher saw, whoever called it:
    ts, who (agent name, or - from git), source (claude | git), verdict
    (fired | clean)."""
    if not os.path.exists(CALLS):
        return []
    rows = []
    with open(CALLS, encoding="utf-8") as f:
        for ln in f:
            parts = ln.rstrip("\n").split("\t")
            if len(parts) < 4:
                continue
            rows.append({"ts": parts[0], "who": parts[1], "source": parts[2], "verdict": parts[3]})
    return rows


def _md_cell(s):
    return str(s).replace("|", "\\|").replace("\n", " ")


def report():
    """The stats as a Markdown page, counted from the same files. Written
    because the first field report about this tool was a summary an agent
    wrote from memory: it said hooks were preventing regressions in a repo
    whose fire log did not exist, and named as a caller an agent that had
    never called. A page a script counts cannot say either."""
    state = load()
    rs = rules()
    fr = fires()
    nudges = [r for r in fr if r["id"] == CAPTURE_ID]
    fr = [r for r in fr if r["id"] != CAPTURE_ID]
    lessons = state.get("lessons", {})
    hooks = {k: v for k, v in lessons.items() if v.get("form") == "hook" and v.get("mode") != "retired"}
    retired = {k: v for k, v in lessons.items() if v.get("mode") == "retired"}
    rule_only = {k: v for k, v in lessons.items() if v.get("form") != "hook" and k not in retired}
    blocking = [k for k in hooks if hooks[k].get("mode") == "block"]
    warning = [k for k in hooks if hooks[k].get("mode") == "warn"]
    # The line's own "[hook]" marker is a column here, not part of the rule.
    text = {i: (s, re.sub(r"^\[hook\]\s*", "", t)) for _, i, s, t in rs}
    loaded = rules(loaded_files())
    warn_at = state.get("loadedWarn", 60)
    calls = read_calls()

    blocked = [r for r in fr if r["outcome"] == "blocked"]
    declined = [r for r in fr if r["outcome"] == "declined"]
    proceeded = [r for r in fr if r["outcome"] == "proceeded"]
    prevented = len(blocked) + len(declined)

    out = []
    p = out.append
    p("# never-again report: " + os.path.basename(ROOT))
    p("")
    p("Counted on %s by `na report` (never-again %s) from `state.json`, `LESSONS.md`, "
      "`fires.log` and `calls.log`. Every number is a line count. No model wrote any of them."
      % (time.strftime("%Y-%m-%d"), VERSION))
    p("")
    p("## Totals")
    p("")
    p("| | |")
    p("|---|---|")
    p("| Lessons filed | %d (%d active, %d retired) |" % (len(lessons), len(lessons) - len(retired), len(retired)))
    p("| Hooks | %d (%d block, %d warn) |" % (len(hooks), len(blocking), len(warning)))
    p("| Rule lines | %d |" % len(rule_only))
    p("| Hook fires | %d |" % len(fr))
    p("| Prevented | %d (%d denied, %d declined at the prompt) |" % (prevented, len(blocked), len(declined)))
    p("| Warned past | %d (asked, and the person went ahead) |" % len(proceeded))
    if state.get("capture", "warn") == "off":
        p("| Capture check | off |")
    else:
        p("| Capture nudges | %d (a fix committed with no lesson filed) |" % len(nudges))
    p("| Rules loaded per turn here | %d (warn above %d) |" % (len(loaded), warn_at))
    p("")
    if hooks and not blocking:
        p("Every hook is in warn mode: a fire asks, and under git it prints and lets the commit "
          "through. Nothing has been blocked in this repository.")
        p("")

    p("## Hooks")
    p("")
    if hooks:
        p("| Lesson | Mode | Fires | Denied | Declined | Proceeded | Ok | Wrong | Streak | Rule |")
        p("|---|---|---|---|---|---|---|---|---|---|")
        for lid in sorted(hooks):
            mine = [r for r in fr if r["id"] == lid]
            c = Counter(r["outcome"] for r in mine)
            g = Counter(r["grade"] for r in mine)
            p("| %s | %s | %d | %d | %d | %d | %d | %d | %d | %s |" % (
                lid, hooks[lid].get("mode", "warn"), len(mine), c["blocked"], c["declined"],
                c["proceeded"], g["ok"], g["wrong"], streak(fr, lid),
                _md_cell(text.get(lid, ("", lid))[1])))
    else:
        p("None.")
    p("")

    p("## Rule lines")
    p("")
    if rule_only:
        p("| Lesson | Scope | Rule |")
        p("|---|---|---|")
        for lid in sorted(rule_only):
            s, t = text.get(lid, ("-", "(no line in LESSONS.md)"))
            p("| %s | %s | %s |" % (lid, _md_cell(s), _md_cell(t)))
    else:
        p("None.")
    p("")

    if retired:
        p("## Retired")
        p("")
        p(", ".join(sorted(retired)) + ". The archive keeps each story.")
        p("")

    p("## Who called the hook")
    p("")
    p("One line per commit the dispatcher saw, from `calls.log`. \"fired\" means a hook or the "
      "capture check had something to say about that commit.")
    p("")
    registered = list(state.get("agents", []))
    try:
        if _settings_hooks(_settings_load()):
            registered.insert(0, "claude")
    except Exception:
        pass
    if calls:
        seen = Counter()
        fired = Counter()
        for r in calls:
            who = "git pre-commit" if r["source"] == "git" else r["who"]
            seen[who] += 1
            if r["verdict"] == "fired":
                fired[who] += 1
        p("| Caller | Commits seen | Fired | Clean |")
        p("|---|---|---|---|")
        for who, n in seen.most_common():
            p("| %s | %d | %d | %d |" % (who, n, fired[who], n - fired[who]))
        p("")
        missing = [a for a in registered if a not in seen]
        if missing:
            p("Registered but never seen calling the hook: " + ", ".join(missing)
              + ". Their commits, if any, met only the git side.")
            p("")
    else:
        p("No `calls.log` yet: no commit has met the dispatcher since it was installed here.")
        p("")

    p("## How to read this")
    p("")
    p("- A fire is one hook asking or denying once. \"Prevented\" is denials plus warn-mode "
      "fires the person stopped at; it is an upper bound, since a retried command fires twice.")
    p("- \"Warned past\" is the honest column: the hook asked, and the commit went ahead. Under "
      "git, warn mode can only print; it cannot hold a commit.")
    p("- A hook checks the files a commit carries. What was already in the tree when the hook "
      "was written is not counted here unless `na sweep` was run over it.")
    p("- `na why L###` prints the full story behind any lesson.")
    print("\n".join(out))
    return 0


def sweep(lid):
    """Run one hook's check over the whole tree, by hand. A hook only ever
    looks at what a commit changes, so the first real catch in the field
    left eight older copies of the same mistake in place: the check had
    never been asked about them."""
    import subprocess
    state = load()
    rec = state.get("lessons", {}).get(lid)
    if not rec or rec.get("form") != "hook":
        sys.exit(f"{lid} is not a hook here")
    script = os.path.join(HOOKS, lid + ".sh")
    if not os.path.isfile(script):
        sys.exit(f"{script} is missing")
    bash = _bash()
    if not bash:
        sys.exit("no bash found; run: NA_ALL=1 bash " + script)
    env = dict(os.environ, CLAUDE_PROJECT_DIR=ROOT)
    if rec.get("verify"):
        args = [bash, script, "--run"]     # a verify hook runs its command over the tree already
    else:
        env["NA_ALL"] = "1"
        args = [bash, script]
    rc = subprocess.call(args, env=env, cwd=ROOT)
    if rc == 0:
        print(f"{lid}: nothing in the tree")
    return rc


CAPTURE_ID = "capture"
CAPTURE_NONE = os.path.join(BASE, ".capture-none")
FIX_RE = re.compile(r"\b(fix|fixes|fixed|fixing|bugfix|hotfix|bug|bugs|revert|reverts|reverted"
                    r"|regression|broke|broken|workaround)\b", re.I)
TYPO_RE = re.compile(r"\btypos?\b", re.I)


SCISSORS = " ------------------------ >8 ------------------------"


def commit_message(cmd):
    """The -m text of the git commit in a shell command, or "" when there is
    none (an editor, a -F file). Lives here rather than in the hook because
    bash 3.2 on macOS cannot parse a quoted heredoc inside $(...).
    The segment regex is na_is_commit's from na-lib.sh, in Python's dialect;
    the dispatcher has already decided this is a commit, so this only has
    to find where the commit's own arguments start. Keep the two in step."""
    m = re.search(r"(^|[;&|(]|then |do |exec |sudo )\s*git(\s+(-[cC]\s+\S+|--?[A-Za-z-]+(=\S+)?))*\s+commit(?=\s|$)", cmd)
    if not m:
        return ""
    rest = cmd[m.end():]
    # The commit's own arguments end at the first chain operator outside
    # quotes, so a `&& git push origin fix/thing` after it is not the message.
    out, q, i = [], None, 0
    while i < len(rest):
        c = rest[i]
        if q:
            if c == "\\" and q == '"':
                out.append(rest[i:i + 2]); i += 2; continue
            if c == q:
                q = None
            out.append(c)
        elif c in ('"', "'"):
            q = c; out.append(c)
        elif c == "\\":
            out.append(rest[i:i + 2]); i += 2; continue
        elif rest.startswith(("&&", "||"), i) or c in ";|":
            break
        else:
            out.append(c)
        i += 1
    args = "".join(out)
    # -m "x", -m"x", -am x, --message=x, and a shell-joined 'it'"'"'s x.
    parts = re.findall(r'(?:^|\s)(?:-[a-zA-Z]*m|--message)(?:=|\s*)'
                       r'((?:"(?:[^"\\]|\\.)*"|\'[^\']*\'|[^\s"\'])+)', args)
    return " ".join(parts)


def message_file_text(path, comment_char):
    """What git will keep of a commit message file: nothing from the
    scissors line down (`git commit -v` puts the whole diff there), no
    comment lines, honouring core.commentChar."""
    cc = comment_char or "#"
    kept = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for ln in fh:
                ln = ln.rstrip("\r\n")
                if ln == cc + SCISSORS:
                    break
                if ln.startswith(cc):
                    continue
                kept.append(ln)
    except OSError:
        return ""
    return "\n".join(kept).strip()[:4000]


def looks_like_fix(msg):
    """A fix by its own account. "typo" is the one word that says "not worth
    a lesson" on its own; everything else is for the person to decide. A
    merge's own message names the branch it merges, and every commit on
    that branch already answered, so merges are not asked."""
    if re.match(r"\s*Merge (branch|remote-tracking branch|pull request|tag|commit)\b", msg):
        return False
    return bool(FIX_RE.search(msg)) and not TYPO_RE.search(msg)


def cmd_capture(argv):
    """`na _capture --cmd CMD | --file PATH [--comment-char C]`: everything
    the capture check needs in one interpreter start. Prints three lines:
    the mode (warn, block, off), the message when it looks like a fix (else
    empty), and the fixed failure since the last commit, if any (else
    empty)."""
    try:
        mode = load().get("capture", "warn")
    except (OSError, ValueError):
        mode = "warn"
    if mode not in ("warn", "block", "off"):
        mode = "warn"
    msg = ""
    if "--cmd" in argv:
        msg = commit_message(argv[argv.index("--cmd") + 1])
    elif "--file" in argv:
        cc = argv[argv.index("--comment-char") + 1] if "--comment-char" in argv else "#"
        msg = message_file_text(argv[argv.index("--file") + 1], cc)
    print(mode)
    print(" ".join(msg.split()) if msg and looks_like_fix(msg) else "")
    # Third line: what the record says, whatever the message says.
    print(_fixed_evidence(fixed_failures(read_failures(), _head())))   # na none is checked by the hook itself
    return 0


# ---------------------------------------------------------------------------
# failures: what failed under the agent, and what passed after the tree changed
#
# The commit message was the only witness to a fix, and the agent writes the
# message. "update styles" can carry a bug fix, and the check read it as
# nothing. The tool call that failed is the better witness: it happened, no
# one wrote it, and the same command passing after the tree changed is a fix
# by any name. Claude Code reports each failed tool call (PostToolUseFailure)
# and each one that passed (PostToolUse); the after-tool hook writes one line
# here for a failure, and one more when that command passes. The capture
# check reads the pairs since the last commit as a second reason to ask, and
# the question then carries the error instead of the message.
FAILURES = os.path.join(BASE, "failures.log")
FAILURES_OPEN = os.path.join(BASE, ".failures-open")   # exists while a failure has no pass yet
# The last column is the HEAD the line was written under: "since the last
# commit" is a question about HEAD, not the clock. A CI runner wrote a
# failure in the same second as the commit before it, and a window drawn
# by timestamp put it on the wrong side.
FAIL_COLS = ("ts", "kind", "key", "tree", "ref", "cmd", "err", "head")
FAIL_KEEP = 300
OPEN_FOR_S = 86400     # a failure nothing passed after in a day is forgotten, so the mark cannot outlive it
# Commands whose non-zero exit is an answer, not a failure: grep found
# nothing, test -f said no, git diff --quiet said "yes, it differs". Nothing
# to fix, so nothing to record. Everything else that fails is a candidate.
FAIL_QUIET = {"grep", "rg", "egrep", "fgrep", "ls", "cat", "find", "which", "test", "[", "[[",
              "head", "tail", "wc", "diff", "cmp", "stat", "true", "false", "type", "command",
              "echo", "printf", "sed", "awk", "sort", "uniq", "cut", "tr", "xargs", "sleep",
              "pwd", "cd", "exit", "return", "read", "git", "gh", "curl", "wget", "ping",
              "ssh", "scp", "rsync", "rm", "mv", "cp", "mkdir", "touch", "chmod", "kill",
              "pkill", "ps", "lsof", "netstat", "date", "env", "export", "source", "."}
ERRISH_RE = re.compile(r"error|fail|assert|traceback|exception|panic|fatal|cannot|not found|"
                       r"unexpected|denied|refused|timed? ?out|^E\s{3}|^\s*[✕×●]", re.I)


def _fail_key(cmd):
    import hashlib
    norm = " ".join(cmd.split())[:400]
    return hashlib.sha1(norm.encode("utf-8", "replace")).hexdigest()[:10]


def _fail_quiet(cmd):
    """True when every segment of CMD is a command whose failure is an
    answer, not something to fix. A chain with one real command in it
    (cd api && npm test) is recorded. Quoted text and heredoc bodies are
    not commands, so they are dropped before the split: `cat <<EOF` with
    a pipe in the text is still a cat."""
    cmd = cmd.split("<<", 1)[0]
    cmd = re.sub(r"'[^']*'|\"(?:[^\"\\\\]|\\\\.)*\"", "", cmd)
    segs = re.split(r"\s*(?:&&|\|\||;|\|)\s*", " ".join(cmd.split()))
    for seg in segs:
        words = seg.split()
        while words and (re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", words[0])
                         or words[0] in ("!", "sudo", "env", "exec", "time", "nohup", "(", "{")):
            words.pop(0)
        if not words:
            continue
        w = words[0].lstrip("(").rsplit("/", 1)[-1]
        if w not in FAIL_QUIET:
            return False
    return True


def _first_error_line(err):
    """The line that says what went wrong: the first that looks like an
    error, else the first line that is not the exit code. A test runner
    prints its banner before the assertion, and the banner is not the
    error."""
    lines = []
    for ln in (err or "").splitlines():
        ln = ln.strip()
        if not ln or re.match(r"^(exit code|command exited with code|exited with code)\s*\d*\.?$", ln, re.I):
            continue
        lines.append(ln)
    for ln in lines:
        if ERRISH_RE.search(ln):
            return ln[:160]
    return lines[0][:160] if lines else "-"


def _fail_cell(v):
    v = " ".join(str(v if v is not None else "-").split())
    return v or "-"


def read_failures():
    rows = []
    if not os.path.exists(FAILURES):
        return rows
    with open(FAILURES, encoding="utf-8", errors="replace") as fh:
        for ln in fh:
            ln = ln.rstrip("\n")
            if not ln.strip():
                continue
            parts = ln.split("\t")
            rows.append(dict(zip(FAIL_COLS, parts + ["-"] * (len(FAIL_COLS) - len(parts)))))
    return rows[-FAIL_KEEP:]


def _append_failure(row):
    """One line, appended: two tool calls can end at once, and a rewrite of
    the whole file from one hook's view loses the other's line."""
    os.makedirs(BASE, exist_ok=True)
    with open(FAILURES, "a", encoding="utf-8", newline="\n") as fh:
        fh.write("\t".join(_fail_cell(row.get(c)) for c in FAIL_COLS) + "\n")


def _trim_failures():
    rows = read_failures()
    try:
        with open(FAILURES, encoding="utf-8", errors="replace") as fh:
            n = sum(1 for _ in fh)
    except OSError:
        return
    if n > 2 * FAIL_KEEP:
        with open(FAILURES, "w", encoding="utf-8", newline="\n") as fh:
            for r in rows:
                fh.write("\t".join(_fail_cell(r.get(c)) for c in FAIL_COLS) + "\n")


def _head():
    return _git("rev-parse", "--verify", "-q", "HEAD") or "initial"   # unborn branch: "initial"


def _answered(head):
    """`na none` was said for the commit about to land."""
    try:
        with open(CAPTURE_NONE, encoding="utf-8") as fh:
            return fh.readline().strip() == head
    except OSError:
        return False


def open_failures(rows):
    """The last line per command, kept when it is a failure nothing has
    passed after and it is younger than a day. Not scoped to HEAD: a
    failure before an unrelated commit is still open after it."""
    last = {}
    for r in rows:
        last[r["key"]] = r
    now = time.time()
    return {k: r for k, r in last.items()
            if r["kind"] == "fail" and now - parse_ts(r["ts"]) < OPEN_FOR_S}


def fixed_failures(rows, head):
    """(failed, passed) pairs whose pass was written under HEAD as it is
    now: the fixes this commit would carry, whatever its message says.
    The failure may predate an earlier commit; the pass is what counts."""
    pend, out = {}, []
    for r in rows:
        if r["kind"] == "fail":
            pend[r["key"]] = r
        elif r["kind"] == "fixed":
            f = pend.pop(r["key"], None)
            if f and r.get("head") == head:
                out.append((f, r))
        elif r["kind"] == "flaky":
            pend.pop(r["key"], None)
    return out


def _argval(argv, flag):
    return argv[argv.index(flag) + 1] if flag in argv and argv.index(flag) + 1 < len(argv) else ""


def cmd_failed(argv):
    """`na _failed --cmd CMD --error TEXT [--tool-use-id ID]`: a tool call
    failed. One line, and the open mark so the after-tool hook knows to
    look at the next calls that pass."""
    cmd = _argval(argv, "--cmd")
    if not cmd or _fail_quiet(cmd):
        return 0
    _append_failure({"ts": now_ts(), "kind": "fail", "key": _fail_key(cmd), "tree": tree_fingerprint(),
                     "ref": _argval(argv, "--tool-use-id") or "-", "cmd": cmd[:160],
                     "err": _first_error_line(_argval(argv, "--error")), "head": _head()})
    with open(FAILURES_OPEN, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(now_ts() + "\n")
    _trim_failures()
    return 0


def cmd_passed(argv):
    """`na _passed --cmd CMD [--agent NAME]`: a tool call passed while a
    failure was open. The same command passing after the tree changed is
    a fix: one line, and one sentence back for the agent in its own
    dialect, which has the error in front of it now and will not at
    commit time. Passing with the tree unchanged is a retry that worked
    (flaky), recorded and not mentioned. Clears the open mark once
    nothing is open, so ordinary calls cost nothing again."""
    cmd = _argval(argv, "--cmd")
    agent = _argval(argv, "--agent") or "claude"
    head = _head()
    hit = open_failures(read_failures()).get(_fail_key(cmd)) if cmd else None
    note = ""
    if hit:
        tree = tree_fingerprint()
        kind = "fixed" if tree != hit["tree"] else "flaky"
        _append_failure({"ts": now_ts(), "kind": kind, "key": hit["key"], "tree": tree,
                         "ref": _argval(argv, "--tool-use-id") or "-", "cmd": hit["cmd"], "err": hit["err"],
                         "head": head})
        if kind == "fixed":
            note = ("never-again: `%s` failed at %s UTC (%s) and passes now that the tree changed. "
                    "If a bug was fixed, capture it with the never-again skill; otherwise the commit "
                    "will ask, and .claude/never-again/na none answers it."
                    % (hit["cmd"][:60], hit["ts"][11:16], hit["err"][:80]))
    # Decide the mark from the file as it is now, not from the view read
    # before this line was written: another hook may have added a failure.
    if not open_failures(read_failures()):
        try:
            os.remove(FAILURES_OPEN)
        except OSError:
            pass
    if note:
        # After a tool call only additionalContext reaches the model; Gemini
        # reads a systemMessage; Copilot and Antigravity have no channel.
        if agent == "gemini":
            print(json.dumps({"systemMessage": note}))
        elif agent not in ("copilot", "antigravity"):
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": note}}))
    return 0


def _fixed_evidence(fixed):
    if not fixed:
        return ""
    f, _ = fixed[-1]
    more = ", and %d more" % (len(fixed) - 1) if len(fixed) > 1 else ""
    err = "" if f["err"] == "-" else " (%s)" % f["err"][:60]
    return "`%s` failed%s and passed after the tree changed%s" % (f["cmd"][:48], err, more)


def fixed_unfiled():
    """The fixed pairs the next commit will be asked about: none once `na
    none` has answered for it."""
    head = _head()
    if _answered(head):
        return []
    return fixed_failures(read_failures(), head)


def failures_cmd(argv):
    """`na failures`: the record, for the skill to file from and the
    person to read."""
    rows = read_failures()
    head = _head()
    fixed = fixed_failures(rows, head)
    opened = open_failures(rows)
    flaky = [r for r in rows if r["kind"] == "flaky" and r.get("head") == head]
    print()
    print("  failed under the agent  (from failures.log; Claude Code reports these)")
    print("  " + "-" * 70)
    if fixed:
        if _answered(head):
            print("\n  fixed  (%d: failed, the tree changed, passed; `na none` answered for the next commit)" % len(fixed))
        else:
            print("\n  fixed  (%d: failed, the tree changed, passed; the commit asks for a lesson or `na none`)" % len(fixed))
        for f, p in fixed:
            print("    %s -> %s  %s" % (f["ts"][11:16], p["ts"][11:16], f["cmd"][:60]))
            if f["err"] != "-":
                print("                    %s" % f["err"][:90])
    if opened:
        print("\n  still failing  (%d; forgotten after a day)" % len(opened))
        for r in sorted(opened.values(), key=lambda r: r["ts"]):
            print("    %s           %s" % (r["ts"][11:16], r["cmd"][:60]))
            if r["err"] != "-":
                print("                    %s" % r["err"][:90])
    if flaky:
        print("\n  passed unchanged  (%d: a retry passed with no change to the tree)" % len(flaky))
        for r in flaky:
            print("    %s           %s" % (r["ts"][11:16], r["cmd"][:60]))
    if not (fixed or opened or flaky):
        print("\n  nothing since the last commit.")
    print()
    return 0


def cmd_none(argv):
    """`na none [why]`: the next commit is a fix with nothing worth a lesson.
    Records HEAD; the capture check stays quiet while HEAD is that commit,
    so the mark clears by itself once the commit lands."""
    head = _git("rev-parse", "--verify", "-q", "HEAD") or "initial"   # unborn branch: "initial"
    why = " ".join(a for a in argv if not a.startswith("-")).strip()
    os.makedirs(BASE, exist_ok=True)
    with open(CAPTURE_NONE, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(head + "\n" + why + "\n")
    print("capture: nothing to learn from the next commit"
          + (" (%s)" % why if why else "") + ". The mark clears once it lands.")
    return 0


def mark(lid, correct):
    state = load()
    entry = state.get("lessons", {}).get(lid)
    if not entry:
        sys.exit(f"{lid} not found in state.json")
    rows = fires()
    ungraded = [r for r in rows if r["id"] == lid and r["grade"] == "-"]
    if not ungraded:
        sys.exit(f"{lid} has no ungraded fire. Grades attach to real fires; "
                 f"there is nothing to grade until the hook fires.")
    row = ungraded[-1]
    row["grade"] = "ok" if correct else "wrong"
    write_log(rows)
    n = streak(rows, lid)
    what = f"{row['ts']} ({row['outcome']})"
    if correct:
        print(f"{lid}: graded {what} correct  -> streak {n}"
              + (f"  -> ready: na promote {lid}" if n >= PROMOTE_AT and entry.get("mode") == "warn" else ""))
    else:
        print(f"{lid}: graded {what} a false positive, streak reset. Narrow the check before promoting.")


def _git(*args):
    import subprocess
    try:
        p = subprocess.run(["git", "-C", ROOT] + list(args), capture_output=True, text=True, encoding="utf-8", errors="replace")
        return p.stdout.strip() if p.returncode == 0 else ""
    except OSError:
        return ""


def promotion_allowed(state):
    """Who may change a hook's mode, per state.json "promotion":
    "pull-request" (default): not on the default branch of a repo with a remote;
    "anyone": always; a list: only a git identity in the list.
    Returns (ok, reason)."""
    rule = state.get("promotion", "pull-request")
    if rule == "anyone":
        return True, ""
    if isinstance(rule, list):
        me = {_git("config", "user.name"), _git("config", "user.email")} - {""}
        if me & set(rule):
            return True, ""
        return False, ("promotion is limited to %s in state.json; you are %s"
                       % (", ".join(rule), ", ".join(sorted(me)) or "unknown to git"))
    # pull-request
    if not _git("remote"):
        return True, ""                       # no remote: nothing to review through
    branch = _git("rev-parse", "--abbrev-ref", "HEAD")
    head = _git("symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    default = head.split("/", 1)[-1] if head else ""
    if branch and branch != "HEAD" and branch not in {default, "main", "master"}:
        return True, "this becomes team-wide when the branch is merged"
    return False, ("promotion is by pull request here (state.json \"promotion\"). "
                   "Make a branch, run this there, and open a pull request; "
                   "or set \"promotion\": \"anyone\" for a single-person repo")


def set_mode(lid, mode):
    state = load()
    entry = state.get("lessons", {}).get(lid)
    if not entry:
        sys.exit(f"{lid} not found in state.json")
    ok, note = promotion_allowed(state)
    if not ok:
        sys.exit(f"{lid} not changed: {note}")
    entry["mode"] = mode
    save(state)
    print(f"{lid} is now {mode}" + (f"  ({note})" if note else ""))


def _settings_hooks(settings, match=None):
    """Every never-again hook entry in a settings dict, as (event, group, entry).
    With `match`, only entries whose command contains it."""
    found = []
    for event, groups in (settings.get("hooks") or {}).items():
        if not isinstance(groups, list):
            continue
        for group in groups:
            for entry in (group or {}).get("hooks", []) or []:
                cmd = (entry or {}).get("command", "").replace("\\", "/")
                if "/.claude/hooks/na/" in cmd and (match is None or match in cmd):
                    found.append((event, group, entry))
    return found


def _drop_settings_entries(settings, entries):
    for _event, group, entry in entries:
        group["hooks"].remove(entry)
    # Drop containers that only existed to hold our entries. Anything the
    # user put here stays, including an empty object they wrote themselves.
    for event, groups in list((settings.get("hooks") or {}).items()):
        settings["hooks"][event] = [g for g in groups if g.get("hooks")]
        if not settings["hooks"][event]:
            del settings["hooks"][event]
    if not settings.get("hooks"):
        settings.pop("hooks", None)


def _write_settings(settings):
    with open(SETTINGS, "w", encoding="utf-8", newline="\n") as fh:
        json.dump(settings, fh, indent=2)
        fh.write("\n")


def retire(lid):
    removed = 0
    for path in lesson_files():
        with open(path, encoding="utf-8") as f:
            lines = f.readlines()
        keep = [ln for ln in lines if f"({lid})" not in ln]
        if len(keep) != len(lines):
            with open(path, "w", encoding="utf-8") as f:
                f.writelines(keep)
            removed += len(lines) - len(keep)
    state = load()
    if lid in state.get("lessons", {}):
        state["lessons"][lid]["mode"] = "retired"
        save(state)

    # A retired hook must stop costing anything: deregister it from Claude
    # Code so the process never spawns, and move its scripts out of the
    # directory the git runner reads. The archive keeps them with the story.
    dropped = 0
    if os.path.isfile(SETTINGS):
        try:
            with open(SETTINGS, encoding="utf-8") as fh:
                settings = json.load(fh)
        except (OSError, ValueError):
            settings = None
        if settings is not None:
            entries = _settings_hooks(settings, match=f"/na/{lid}.sh")
            if entries:
                _drop_settings_entries(settings, entries)
                _write_settings(settings)
                dropped = len(entries)
    try:
        os.remove(os.path.join(VERIFIED, lid))
    except OSError:
        pass
    moved = []
    if os.path.isdir(HOOKS):
        os.makedirs(ARCHIVE, exist_ok=True)
        for name in sorted(os.listdir(HOOKS)):
            if name == f"{lid}.sh" or name.startswith(f"{lid}-"):
                os.replace(os.path.join(HOOKS, name), os.path.join(ARCHIVE, name))
                moved.append(name)
    print(f"{lid} retired ({removed} line removed, {dropped} hook entr{'y' if dropped == 1 else 'ies'} deregistered"
          + (f", moved to archive: {', '.join(moved)}" if moved else "") + "). Archive kept.")


def sort_rules():
    counts = Counter(r["id"] for r in fires())
    for path in lesson_files():
        with open(path, encoding="utf-8") as f:
            lines = f.read().split("\n")
        idx = [i for i, ln in enumerate(lines) if RULE_RE.match(ln)]
        if len(idx) < 2:
            continue
        rule_lines = [lines[i] for i in idx]
        ordered = sorted(rule_lines, key=lambda ln: -counts.get(RULE_RE.match(ln).group("id"), 0))
        if ordered == rule_lines:
            print(f"{os.path.relpath(path, ROOT)}: already ordered")
            continue
        for i, ln in zip(idx, ordered):
            lines[i] = ln
        with open(path, "w", encoding="utf-8") as f:
            f.write("\n".join(lines))
        print(f"{os.path.relpath(path, ROOT)}: reordered {len(idx)} rules, most-hit first")


def why(lid):
    path = os.path.join(ARCHIVE, f"{lid}.md")
    if not os.path.exists(path):
        sys.exit(f"no archive entry for {lid}")
    print(open(path, encoding="utf-8").read())



